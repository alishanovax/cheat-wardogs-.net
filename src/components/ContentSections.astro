---
import { t } from '../i18n';
import { getHomepageBlogPosts } from '../data/blog';
import type { BlogPost } from '../i18n/types';
import type { BlogPostFull } from '../data/blog/types';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

interface Props {
  blogPostCount?: number;
  /** When set (e.g. homepage), reuse the same list as JSON-LD so titles and URLs stay in sync */
  posts?: (BlogPost | BlogPostFull)[];
  showWorkflow?: boolean;
  showFaq?: boolean;
  uniqueBlogAnchors?: boolean;
}

const {
  blogPostCount = 3,
  posts: postsProp,
  showWorkflow = true,
  showFaq = true,
  uniqueBlogAnchors = false,
} = Astro.props;
const homeFaqs = getLandingFaqs();
const featuredPosts = postsProp ?? getHomepageBlogPosts(blogPostCount);
const [heroPost, ...restPosts] = featuredPosts;
const homeReadAria = (slug: string) => `Read home guide: ${slug}`;
---

{showWorkflow && <WorkflowSection />}

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    {
      heroPost ? (
        <div class="mt-12 min-w-0">
          <BlogCard
            post={heroPost}
            index={0}
            eager
            showDate
            layout="hero"
            readCtaLabel={t.blog.read}
            readCtaAriaLabel={uniqueBlogAnchors ? homeReadAria(heroPost.slug) : undefined}
          />
        </div>
      ) : null
    }

    {
      restPosts.length > 0 ? (
        <ul class="mt-10 grid min-w-0 list-none gap-8 p-0 sm:grid-cols-2 lg:mt-12 [&>*]:min-w-0">
          {restPosts.map((post, i) => (
            <li>
              <BlogCard
                post={post}
                index={i + 1}
                showDate
                layout="homeRow"
                readCtaLabel={t.blog.read}
                readCtaAriaLabel={uniqueBlogAnchors ? homeReadAria(post.slug) : undefined}
              />
            </li>
          ))}
        </ul>
      ) : null
    }

    <div class="mt-10 flex justify-start lg:justify-center">
      <Button as="a" href={ROUTES.blog} variant="outline">
        {t.blog.viewAll}
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</section>

{showFaq && <SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />}
