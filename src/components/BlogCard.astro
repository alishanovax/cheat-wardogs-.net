---
import '../styles/blog-pages.css';
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './icons/Icon.astro';
import { CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { blogPostPath } from '../utils/path';
import type { BlogPost } from '../i18n/types';
import { t } from '../i18n';
import { getBlogPostTimestamp, getBlogReadMinutes, getPostReadTime } from '../data/blog';
import type { BlogPostFull } from '../data/blog/types';
import { blogTagIcons } from '../data/sectionIcons';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardFooter, CardTitle } from '@/components/starwind/card';

interface Props {
  post: BlogPost | BlogPostFull;
  index?: number;
  eager?: boolean;
  /** Show date on image (blog index grid) */
  showDate?: boolean;
  /** default: grid card; featured: split media+body; hero: homepage spotlight; homeRow: larger compact cards */
  layout?: 'default' | 'featured' | 'hero' | 'homeRow';
  /** Prepended to image alt (blog index SEO). */
  imageAltPrefix?: string;
  /** Use neutral data-article-card on index (avoids blog* in DOM for SEO audits). */
  indexCard?: boolean;
  readCtaLabel?: string;
  /** Optional; use for a longer unique label (e.g. SEO) while keeping button text short */
  readCtaAriaLabel?: string;
  class?: string;
}

const {
  post,
  index = 0,
  eager = false,
  showDate = false,
  layout = 'default',
  imageAltPrefix = '',
  indexCard = false,
  readCtaLabel,
  readCtaAriaLabel,
  class: className,
} = Astro.props;
const isFeatured = layout === 'featured' || layout === 'hero';
const isHero = layout === 'hero';
const isHomeRow = layout === 'homeRow';
const href = blogPostPath(post.slug);
const timestamp = getBlogPostTimestamp(post.date);
const readTimeLabel = getPostReadTime(post);
const readMinutes = getBlogReadMinutes(readTimeLabel);
const tagIcon: IconName = blogTagIcons[post.tag] ?? 'tag';
---

<Card
  size="md"
  class:list={[
    'blog-card group/card gap-0 overflow-visible border border-border py-0 pt-0 shadow-xs ring-0 ring-transparent hover:shadow-md has-data-[slot=card-footer]:pb-0',
    isFeatured
      ? [
          'blog-featured lg:grid lg:grid-cols-[1.05fr_0.95fr]',
          isHero ? 'lg:items-start' : 'lg:items-stretch',
          isHero && 'blog-card--hero',
          isHero ? 'mt-2 md:mt-4' : 'mt-8 md:mt-10',
        ]
      : 'flex h-full min-w-0 flex-col',
    className,
  ]}
  {...(indexCard ? { 'data-article-card': true } : { 'data-blog-card': true })}
  data-tag={post.tag}
  data-ts={timestamp}
  data-read-minutes={readMinutes}
>
  <a
    href={href}
    data-card-cover
    class:list={[
      'blog-card__media relative block overflow-hidden focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-card',
      !isFeatured && 'aspect-video',
      isFeatured &&
        (isHero
          ? 'blog-featured__media blog-featured__media--hero aspect-video min-h-[11rem] max-h-[min(18rem,38vh)] sm:min-h-[12rem] sm:max-h-[min(20rem,36vh)] lg:min-h-0 lg:max-h-[18rem] lg:self-stretch lg:aspect-[16/10]'
          : 'blog-featured__media aspect-video lg:aspect-auto lg:min-h-[16rem] lg:self-stretch'),
    ]}
    tabindex="-1"
    aria-hidden="true"
  >
    <ResponsiveImage
      src={post.image}
      alt={`${imageAltPrefix}${post.title} — War Dogs product imagery`}
      width={isFeatured ? (isHero ? 1200 : 960) : 640}
      height={isFeatured ? (isHero ? 675 : 540) : 360}
      widths={isFeatured ? undefined : CARD_IMAGE_WIDTHS}
      sizes={
        isFeatured
          ? isHero
            ? '(min-width: 1024px) min(58vw, 720px), 100vw'
            : '(min-width: 1024px) 560px, 100vw'
          : CARD_IMAGE_SIZES
      }
      loading={eager ? 'eager' : 'lazy'}
      fetchPriority={eager ? 'high' : undefined}
      class:list={[
        'size-full object-cover transition-transform duration-500 ease-out group-hover/card:scale-[1.03]',
        isFeatured && 'lg:absolute lg:inset-0 lg:h-full lg:w-full lg:max-w-none',
      ]}
    />

    <div
      class:list={[
        'pointer-events-none absolute inset-x-0 top-0 z-10 flex items-start justify-between gap-2',
        isHero ? 'p-4 sm:p-5' : 'p-3',
      ]}
    >
      <Badge
        tone="neutral"
        appearance="frosted"
        size={isHero ? 'md' : 'sm'}
        class:list={['gap-1.5 shadow-sm', isHero && 'text-sm']}
      >
        <Icon name={tagIcon} size={isHero ? 16 : 14} />
        {post.tag}
      </Badge>
      {
        showDate ? (
          <Badge
            tone="neutral"
            appearance="frosted"
            size={isHero ? 'md' : 'sm'}
            class:list={['gap-1.5 shadow-sm', isHero && 'text-sm']}
          >
            <Icon name="calendar" size={isHero ? 16 : 14} />
            {post.date}
          </Badge>
        ) : (
          <Badge
            tone="neutral"
            appearance="frosted"
            size={isHero ? 'md' : 'sm'}
            class:list={['gap-1.5 shadow-sm', isHero && 'text-sm']}
          >
            <Icon name="clock" size={isHero ? 16 : 14} />
            {readTimeLabel}
          </Badge>
        )
      }
    </div>

    <span
      class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
      aria-hidden="true"
    />
  </a>

  <div class:list={['blog-card__body', isFeatured ? 'blog-featured__body lg:border-l lg:border-border' : 'flex min-h-0 flex-1 flex-col']}>
    <CardContent
      class:list={[
        'flex flex-1 flex-col gap-2.5 p-4 pb-3',
        isFeatured &&
          (isHero
            ? 'justify-center gap-2.5 border-t border-border p-5 pb-4 sm:p-6 sm:pb-5 lg:border-t-0 lg:py-6 lg:pl-8 lg:pr-6'
            : 'justify-center border-t border-border p-5 sm:p-6 lg:border-t-0 lg:py-6 lg:pl-8 lg:pr-6'),
        isHomeRow && 'gap-3 p-5 pb-4 sm:p-6',
      ]}
    >
      <CardTitle
        class:list={[
          'font-semibold normal-case leading-snug tracking-tight',
          isHero
            ? 'text-lg !text-lg font-semibold leading-snug sm:text-xl md:text-[1.25rem] lg:text-[1.35rem]'
            : isHomeRow
              ? 'text-lg !text-lg sm:text-xl md:text-[1.25rem]'
              : 'text-base !text-base md:text-[1.0625rem]',
        ]}
      >
        <a
          href={href}
          class="text-foreground decoration-primary/0 underline-offset-4 transition-colors hover:text-primary hover:underline"
        >
          {post.title}
        </a>
      </CardTitle>

      <p
        class:list={[
          'leading-relaxed text-muted-foreground',
          isHero
            ? 'text-sm sm:text-base line-clamp-4 md:line-clamp-5'
            : isHomeRow
              ? 'text-base line-clamp-3 sm:line-clamp-4'
              : isFeatured
                ? 'text-base line-clamp-5 md:line-clamp-6'
                : 'text-base line-clamp-4 sm:line-clamp-5',
        ]}
      >
        {post.desc}
      </p>
    </CardContent>

    <CardFooter
      class:list={[
        'blog-card__footer mt-auto rounded-none border-border/80 bg-transparent shadow-none',
        isHero ? 'px-5 pb-6 pt-2 sm:px-6 sm:pb-6 lg:pl-8 lg:pr-6' : 'px-4 pb-6 pt-4 sm:px-5 sm:pb-6',
      ]}
    >
      <p
        class:list={[
          'blog-card__footer-meta text-muted-foreground',
          'text-sm',
        ]}
      >
        {
          /* Date already shows on the image when showDate is set — keep footer to one clean row */
          !showDate ? (
            <>
              <Icon name="calendar" size={isHero ? 16 : 14} class="blog-card__footer-icon" aria-hidden="true" />
              <span>{post.date}</span>
              <span class="blog-card__footer-dot" aria-hidden="true">·</span>
            </>
          ) : null
        }
        <Icon name="clock" size={isHero ? 16 : 14} class="blog-card__footer-icon" aria-hidden="true" />
        <span>{readTimeLabel}</span>
      </p>
      {
        indexCard ? (
          <a href={href} class="article-card__read" {...(readCtaAriaLabel ? { 'aria-label': readCtaAriaLabel } : {})}>
            {readCtaLabel ?? t.blog.read}
            <Icon name="arrowRight" size={16} />
          </a>
        ) : (
          <Button
            as="a"
            href={href}
            variant="outline"
            size="sm"
            class="blog-card__read"
            {...(readCtaAriaLabel ? { 'aria-label': readCtaAriaLabel } : {})}
          >
            {readCtaLabel ?? t.blog.read}
            <Icon name="arrowRight" size={16} />
          </Button>
        )
      }
    </CardFooter>
  </div>
</Card>
