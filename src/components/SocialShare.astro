---
import { canonicalUrl } from '../config/seo';

interface Props {
  title?: string;
  class?: string;
}

const { title = 'War Dogs Cheats', class: className } = Astro.props;
const pageUrl = canonicalUrl(Astro.url.pathname, Astro.url.origin);
const encodedUrl = encodeURIComponent(pageUrl);
const encodedText = encodeURIComponent(title);
---

<nav class:list={['social-share flex flex-wrap items-center gap-2', className]} aria-label="Share this page">
  <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Share</span>
  <a
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`}
    class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-primary"
    rel="noopener noreferrer"
    target="_blank">X</a>
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-primary"
    rel="noopener noreferrer"
    target="_blank">Facebook</a>
  <a
    href={`https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`}
    class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-primary"
    rel="noopener noreferrer"
    target="_blank">Telegram</a>
  <a
    href={`https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedText}`}
    class="rounded-md border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-primary"
    rel="noopener noreferrer"
    target="_blank">Reddit</a>
</nav>
