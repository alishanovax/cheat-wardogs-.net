---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { websiteSchema, itemListSchema } from '../utils/schema';
import { webpSrc } from '../utils/responsiveImage';
import { PRIMARY_CHEAT_IMAGE } from '../config/siteImages';
import SocialShare from '../components/SocialShare.astro';
import { getHomepageBlogPosts } from '../data/blog';
import { blogPostPath } from '../utils/path';

const seo = resolvePageSeo('/');

const heroLcpImage = webpSrc(PRIMARY_CHEAT_IMAGE, 512);
const homeBlogPosts = getHomepageBlogPosts(3);
const homeBlogItemList = itemListSchema(
  homeBlogPosts.map((p) => ({ name: p.title, url: blogPostPath(p.slug) })),
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), homeBlogItemList]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection titleBrand={seo.h1} titleAccent={seo.h1Accent} />
  <FeaturesSection />
  <ProductsSection maxProducts={6} useCarousel={false} uniqueCardAnchors />
  <ContentSections blogPostCount={3} showWorkflow={false} showFaq={false} uniqueBlogAnchors />
  <div class="mx-auto max-w-6xl px-5 pb-8">
    <SocialShare title={seo.title} class="border-t border-border pt-6" />
  </div>
</BaseLayout>
