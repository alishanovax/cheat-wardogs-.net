---
import CheckoutBridgeLayout from '../../../layouts/CheckoutBridgeLayout.astro';
import { ZADEYO_WAR_DOGS_CHECKOUT_URL, ZADEYO_WAR_DOGS_PRODUCT_SEO } from '../../../config/zadeyoWarDogsProductSeo';
import { productSchema } from '../../../utils/schema';
import { PRIMARY_CHEAT_IMAGE } from '../../../config/siteImages';
import { Button } from '@/components/starwind/button';

const seo = ZADEYO_WAR_DOGS_PRODUCT_SEO;
const headingFor = (key: (typeof seo.bodySections)[number]['headingKey']) => seo[key];
---

<CheckoutBridgeLayout
  title={seo.title}
  description={seo.description}
  logoAlt={seo.logoAlt}
  ogImage={PRIMARY_CHEAT_IMAGE}
  ogImageAlt="War Dogs PC — checkout hand-off preview"
  jsonLd={[
    productSchema({
      name: seo.h1,
      description: seo.description,
      url: '/go/war-dogs/',
      offerUrl: ZADEYO_WAR_DOGS_CHECKOUT_URL,
      image: PRIMARY_CHEAT_IMAGE,
    }),
  ]}
>
  <style slot="head" is:inline>
    @media (max-width: 639px) {
      :root {
        --zadeyo-rbp: phone;
      }
    }
    @media (min-width: 640px) and (max-width: 1023px) {
      :root {
        --zadeyo-rbp: tablet;
      }
    }
    @media (min-width: 1024px) {
      :root {
        --zadeyo-rbp: desktop;
      }
    }
  </style>
  <article>
    <header class="space-y-4 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">ZADEYO · War Dogs PC</p>
      <h1 class="text-3xl font-bold leading-tight md:text-4xl">{seo.h1}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{seo.intro}</p>
      <Button as="a" href={ZADEYO_WAR_DOGS_CHECKOUT_URL} variant="primary" size="lg" class="mt-2">
        Open ZADEYO secure checkout
      </Button>
    </header>

    <figure class="mt-8 overflow-hidden rounded-xl border border-border">
      <img
        src={PRIMARY_CHEAT_IMAGE}
        alt="War Dogs product preview — illustrative imagery until custom assets are supplied"
        width="920"
        height="430"
        loading="lazy"
        class="h-auto w-full object-cover"
      />
    </figure>

    <section class="mt-10 space-y-4" aria-labelledby="product-details-title">
      <h2 id="product-details-title" class="text-xl font-semibold">{seo.h2ProductDetails}</h2>
      <p class="text-muted-foreground">
        Compare tiers on{' '}
        <a href="/pd/wd/" class="text-primary hover:underline">cheatwardogs.net War Dogs product catalog</a>
        {' '}before you continue. Checkout and license delivery run on ZADEYO.
      </p>
    </section>

    <section class="mt-8 space-y-4" aria-labelledby="features-title">
      <h2 id="features-title" class="text-xl font-semibold">{seo.h2Features}</h2>
      {seo.sections.map((section) => (
        <div class="space-y-2">
          <h3 class="text-lg font-semibold">{section.heading}</h3>
          {section.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      ))}
      <ul class="list-disc space-y-2 pl-5 text-muted-foreground">
        <li>Open Zadeyo for the authoritative module list (ESP, aim assists, radar, etc.).</li>
        <li>Note Windows requirements and anti-cheat notes shown on that page.</li>
        <li>Keep your receipt email for portal access after payment.</li>
      </ul>
    </section>

    <section class="mt-8 space-y-3" aria-labelledby="system-requirements-title">
      <h2 id="system-requirements-title" class="text-xl font-semibold">{seo.h2SystemRequirements}</h2>
      <p class="text-muted-foreground">
        Read the OS and hardware section on Zadeyo—requirements override any summary on cheatwardogs.net.
      </p>
    </section>

    {
      seo.bodySections.map((block) => (
        <section class="mt-8 space-y-3" aria-labelledby={`go-war-dogs-${block.id}`}>
          <h2 id={`go-war-dogs-${block.id}`} class="text-xl font-semibold">
            {headingFor(block.headingKey)}
          </h2>
          {block.paragraphs.map((paragraph) => (
            <p class="text-muted-foreground">{paragraph}</p>
          ))}
        </section>
      ))
    }

    <section class="mt-8 space-y-3" aria-labelledby="checkout-help-title">
      <h2 id="checkout-help-title" class="text-lg font-semibold">Before you buy</h2>
      <p class="text-muted-foreground">
        Read the{' '}
        <a href="/faq/" class="text-primary hover:underline">FAQ on risk and setup</a>
        {' '}
        or open the{' '}
        <a href="/support/" class="text-primary hover:underline">support page for site navigation</a>.
      </p>
    </section>
  </article>
</CheckoutBridgeLayout>
