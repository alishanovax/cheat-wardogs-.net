---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../../config/seo';
import { PRIMARY_CHEAT_IMAGE } from '../../config/siteImages';
import { checkoutPath } from '../../config/checkout';
import { warDogsCheatsLanding } from '../../data/warDogsCheatsLanding';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/war-dogs-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'PC', path: '/war-dogs-cheats/' },
];
const checkout = checkoutPath('warDogs');
const copy = warDogsCheatsLanding;

function linkify(text: string): string {
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, label: string, href: string) => {
    const path = href.startsWith('/') ? href : `/${href}`;
    return `<a href="${path}">${label}</a>`;
  });
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({ name: seo.title, description: seo.description, url: '/war-dogs-cheats/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <figure class="mt-6 overflow-hidden rounded-xl border border-border">
        <ResponsiveImage
          src={PRIMARY_CHEAT_IMAGE}
          alt="War Dogs cheats PC preview — illustrative imagery until you supply final art"
          width={960}
          height={540}
          loading="eager"
          fetchPriority="high"
          sizes="(min-width: 768px) 720px, 100vw"
          class="w-full object-cover"
        />
      </figure>

      <header class="mt-8 space-y-4 text-left">
        <h1 class="text-3xl font-bold normal-case leading-tight md:text-4xl">{copy.h1}</h1>
        <h2 class="text-xl font-semibold text-foreground">{copy.keywordH2}</h2>
        <p class="text-lg leading-relaxed text-muted-foreground">{copy.intro}</p>
        <Button as="a" href={checkout} variant="primary" size="lg" class="rounded-xl">
          Start checkout
        </Button>
      </header>

      <Prose class="mt-10 max-w-none text-left">
        {
          copy.sections.map((section) => (
            <section class="mt-8">
              <h3>{section.heading}</h3>
              {section.paragraphs.map((paragraph) => (
                <p set:html={linkify(paragraph)} />
              ))}
            </section>
          ))
        }
      </Prose>

      <div class="mt-10 flex flex-wrap gap-3 border-t border-border pt-8">
        <Button as="a" href={checkout} variant="primary" size="sm" class="rounded-full">
          Start checkout
        </Button>
        <Button as="a" href={ROUTES.products} variant="outline" size="sm" class="rounded-full">
          Compare tiers
        </Button>
      </div>
    </div>
  </article>
</BaseLayout>
