{
  "name": "cheatwardogs-net",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "check": "astro check",
    "ci": "npm run check && npm run build",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "deploy": "npm run ci && wrangler deploy",
    "postinstall": "node scripts/cloudflare-postinstall.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "install:images": "node scripts/install-r6-hack-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true,
    "workerd@1.20261104.1": true
  }
}
